{
  "info": {
    "_postman_id": "5f0c2a1e-acme-support",
    "name": "Acme Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:9003"
    }
  ],
  "item": [
    {
      "name": "issues",
      "item": [
        {
          "name": "Search issues",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rest/api/2/search"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jql\":\"org = \\\"NWT\\\" AND status != Done\",\"maxResults\":20}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get issue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rest/api/2/issue/NWT-482"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create issue",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rest/api/2/issue"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"fields\":{\"project\":\"NWT\",\"summary\":\"Example\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Assign issue",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rest/api/2/issue/NWT-482/assignee"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"dana@acme.example\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "comments",
      "item": [
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rest/api/2/issue/NWT-482/comment"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"body\":\"Moving to finance support\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}